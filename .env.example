# --- ИИ-провайдер: openrouter | groq | ollama ---
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat:free
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Поведение ---
DRY_RUN=0
VIRALITY_THRESHOLD=7
RESONANCE_HOURS=2
BSKY_MIN_LIKES=20
BSKY_MIN_REPOSTS=5
MAX_POSTS_PER_RUN=2
MAX_LLM_CALLS_PER_RUN=6
MAX_LLM_CALLS_PER_DAY=40
ITEM_MAX_AGE_HOURS=24
DB_PATH=data/state.db
LOG_LEVEL=INFO
